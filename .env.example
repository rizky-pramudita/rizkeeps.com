# Postgres connection string (Drizzle ORM)
DB_URL=postgres://user:password@host:5432/dbname

# Redis connection string (sessions, rate limiting, content cache)
REDIS_URL=redis://localhost:6379

# Email delivery for the contact form (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Optional: a verified sender. Defaults to Resend's onboarding sender for testing.
RESEND_FROM=rizkeeps <onboarding@resend.dev>

# Admin login
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: any random string (reserved for future signing use)
SESSION_SECRET=

# Public site URL (used for metadata, sitemap, robots, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://rizkeeps.com
